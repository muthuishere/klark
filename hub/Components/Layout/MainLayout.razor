@inherits LayoutComponentBase
@inject HubAccounts Accounts
@inject HubAccess Access

<header class="topbar">
    <a class="brand" href="/">@if (!string.IsNullOrWhiteSpace(Brand.Logo)) {<img class="logo" src="@Brand.Logo" alt="" />}<span class="brand-text">@Brand.Name@if (!string.IsNullOrWhiteSpace(Brand.Tagline)) {<small class="tagline">@Brand.Tagline</small>}</span></a>
    <AuthorizeView>
        <Authorized>
            <details class="menu">
                <summary class="icon" aria-label="Menu">⋯</summary>
                <div class="menu-pop">
                    <div class="menu-info">@(context.User.FindFirst("display_name")?.Value ?? context.User.Identity?.Name)</div>
                    <a href="/messages">Messages</a>
                    <a href="/token">CLI token</a>
                    @if (context.User.FindFirst(AccountEndpoints.SourceClaim)?.Value is DirectoryUser.BuiltIn or DirectoryUser.Mock)
                    {
                        <a href="/account/password">Change password</a>
                    }
                    @if (Access.IsAdmin(context.User))
                    {
                        <a href="/admin/users">Users</a>
                        <a href="/admin/directory">Sign-in directory</a>
                        <a href="/admin/machines">Machines</a>
                    }
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="menu-item">Sign out</button>
                    </form>
                </div>
            </details>
        </Authorized>
    </AuthorizeView>
</header>
<AuthorizeView>
    <Authorized>
        @if (context.User.FindFirst(AccountEndpoints.SourceClaim)?.Value == DirectoryUser.BuiltIn && Accounts.AdminPasswordIsDefault())
        {
            <a class="banner" href="/account/password">Change the default admin password</a>
        }
    </Authorized>
</AuthorizeView>
<main class="page">
    @Body
</main>

<div id="blazor-error-ui">
    Something went wrong. <a href="" class="reload">Reload</a>
</div>
