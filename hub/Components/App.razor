<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <title>@Brand.Title</title>
    @if (!string.IsNullOrWhiteSpace(Brand.Logo)) {<link rel="icon" href="@Brand.Logo" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#262624" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <script>try{localStorage.setItem("klark:brand",@((MarkupString)System.Text.Json.JsonSerializer.Serialize(Brand.Name)));var t=localStorage.getItem("klark:theme");document.documentElement.dataset.theme=t||"paper";if(localStorage.getItem("klark:side")==="closed")document.documentElement.classList.add("side-closed")}catch(e){}</script>
    <HeadOutlet />
</head>
<body>
    <Routes />
    @* Bundled, pinned copies (ADR 0011, C). xterm and highlight.js load on demand (terminal.js, chat.js). *@
    <script src="@Assets["chat.js"]"></script>
    <script src="@Assets["terminal.js"]"></script>
    <script src="@Assets["idle.js"]"></script>
    @* No WebSockets anywhere (ADR 0013): the circuit uses Server-Sent Events, long polling as a fallback.
       2 | 4 = HttpTransportType.ServerSentEvents | LongPolling (signalR is not a global here). *@
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({ circuit: { configureSignalR: b => b.withUrl("_blazor", { transport: 2 | 4 }) } });
    </script>
</body>
</html>
