@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@Brand.Name</PageTitle>

@* The list is the sidebar (ADR 0011, E): on a phone it is the whole page, on a desktop
   it sits beside an empty main area until a chat is picked. *@
<div class="app home">
    <Sidebar />
    <main class="pane-app home-main">
        <div class="home-empty">
            <div class="mark">✻</div>
            <h1>Pick an agent</h1>
            <p class="muted">Chats are grouped by project folder. <kbd>⌘K</kbd> searches agents, folders, machines and messages.</p>
            <p class="muted">No machine yet? On it, run <code>klark hub connect --url http://&lt;this-host&gt;:7470</code> and approve it here.</p>
        </div>
    </main>
</div>
