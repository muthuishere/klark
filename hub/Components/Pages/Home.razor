@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject MachineRegistry Registry

<PageTitle>klark hub</PageTitle>

<h1>Machines</h1>

<input class="search" placeholder="Filter panes by title, agent, folder…" @bind="filter" @bind:event="oninput" />

@if (Registry.Machines.Count == 0)
{
    <p class="empty">No machines are linked yet. On a machine, run
        <code>klark link --hub ws://&lt;this-host&gt;:8080/agent --token &lt;token&gt;</code>.</p>
}

@foreach (var machine in Registry.Machines)
{
    var panes = Visible(machine.Tree.Panes).ToList();
    <section class="machine">
        <h2>@machine.Name <small>@machine.Host · klark @machine.Version · @machine.Tree.Panes.Count panes</small></h2>
        @if (panes.Count == 0)
        {
            <p class="empty">@(machine.Tree.Panes.Count == 0 ? "Waiting for this machine's panes…" : "No pane matches the filter.")</p>
        }
        else
        {
            <ul class="panes">
                @foreach (var pane in panes.OrderByDescending(p => Rank(p.AgentStatus)))
                {
                    <li>
                        <a href="@($"/m/{Uri.EscapeDataString(machine.Id)}/p/{Uri.EscapeDataString(pane.Id)}")">
                            <span class="status status-@Css(pane.AgentStatus)">@Label(pane.AgentStatus)</span>
                            <span class="title">@pane.Title</span>
                            @if (!string.IsNullOrEmpty(pane.Agent)) { <span class="agent">@pane.Agent</span> }
                            <span class="cwd">@machine.Tree.WorkspaceLabel(pane.WorkspaceId) · @pane.Cwd</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private string filter = "";

    protected override void OnInitialized() => Registry.Changed += OnChanged;

    private int renderQueued;

    // Many machines can change at once; repaint at most four times a second.
    private void OnChanged()
    {
        if (Interlocked.Exchange(ref renderQueued, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(250);
            Interlocked.Exchange(ref renderQueued, 0);
            StateHasChanged();
        });
    }

    public void Dispose() => Registry.Changed -= OnChanged;

    private IEnumerable<PaneInfo> Visible(IEnumerable<PaneInfo> panes) =>
        string.IsNullOrWhiteSpace(filter)
            ? panes
            : panes.Where(p => $"{p.Title} {p.Agent} {p.Cwd}".Contains(filter, StringComparison.OrdinalIgnoreCase));

    // Blocked agents first: those are the ones waiting for a person.
    private static int Rank(string status) => status switch { "blocked" => 3, "working" => 2, "idle" => 1, _ => 0 };
    private static string Css(string status) => string.IsNullOrEmpty(status) ? "none" : status;
    private static string Label(string status) => string.IsNullOrEmpty(status) ? "shell" : status;
}
