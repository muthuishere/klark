@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using System.Security.Claims
@using System.Text.Json.Nodes
@inject MachineRegistry Registry
@inject HubStore Store
@inject HubAccess Access
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS

<PageTitle>klark</PageTitle>

<div class="home-list">
<input class="search" type="search" placeholder="Search" aria-label="Search sessions" value="@filter" @oninput="OnFilterAsync" />

@if (Mine.Count == 0 && offlineMachines.Count == 0)
{
    <p class="empty">No machines are linked yet. On a machine, run
        <code>klark expose --hub ws://&lt;this-host&gt;:8080/agent --token &lt;token&gt;</code>.</p>
}

@foreach (var machine in Mine)
{
    var panes = Visible(machine.Name, machine.Tree, machine.Tree.Panes).ToList();
    <section class="machine">
        <h2>@machine.Name</h2>
        @if (machine.Tree.Panes.Count == 0)
        {
            <ul class="panes" aria-busy="true">
                @for (var i = 0; i < 3; i++) { <li class="skel-row"><span class="skel dotsk"></span><span class="skel line"></span></li> }
            </ul>
        }
        else if (panes.Count == 0)
        {
            <p class="empty">No match.</p>
        }
        else
        {
            <ul class="panes">
                @foreach (var pane in panes.OrderByDescending(p => Rank(p.AgentStatus)))
                {
                    var href = $"/m/{Uri.EscapeDataString(machine.Id)}/p/{Uri.EscapeDataString(pane.Id)}";
                    <li>
                        <a href="@href" class="@(href == lastHref ? "last" : null)" data-pane-link>
                            <span class="dot dot-@Css(pane.AgentStatus)" title="@Label(pane.AgentStatus)"></span>
                            <span class="title">@pane.DisplayName</span>
                            @if (pane.AgentStatus == "blocked") { <span class="needs">needs you</span> }
                            <span class="sub">@Sub(machine.Tree, pane)</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>
}

@if (offlineMachines.Count > 0)
{
    <h2 class="section">Offline</h2>
    @foreach (var known in offlineMachines)
    {
        <section class="machine offline">
            <h2>
                <button type="button" class="link fold" aria-expanded="@openOffline.ContainsKey(known.Id)" @onclick="() => ToggleOfflineAsync(known.Id)">@(openOffline.ContainsKey(known.Id) ? "▾" : "▸") @known.Id</button>
                <small>seen @known.LastSeen.ToLocalTime().ToString("g")</small>
            </h2>
            @if (openOffline.TryGetValue(known.Id, out var tree))
            {
                @if (tree is null || tree.Panes.Count == 0)
                {
                    <p class="empty">Nothing was recorded.</p>
                }
                else
                {
                    <ul class="panes">
                        @foreach (var pane in Visible(known.Id, tree, tree.Panes))
                        {
                            var href = $"/m/{Uri.EscapeDataString(known.Id)}/p/{Uri.EscapeDataString(pane.Id)}";
                            <li>
                                <a href="@href" class="@(href == lastHref ? "last" : null)" data-pane-link>
                                    <span class="dot dot-none"></span>
                                    <span class="title">@pane.DisplayName</span>
                                    <span class="sub">@Sub(tree, pane)</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }
}
</div>

@code {
    private ClaimsPrincipal user = new();
    private List<KnownMachine> offlineMachines = new();
    private readonly Dictionary<string, SessionTree?> openOffline = new();

    /// <summary>Connected machines this user may see (STATUS S-05).</summary>
    private List<MachineConnection> Mine => Registry.Machines.Where(m => Access.CanSee(user, m.Id)).ToList();

    protected override async Task OnInitializedAsync()
    {
        user = (await Auth.GetAuthenticationStateAsync()).User;
        await LoadOfflineAsync();
        pullTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PullLoopAsync(pullTimer);
    }

    /// <summary>Known machines that are not linked right now; their pane lists load only when expanded (STATUS S-07).</summary>
    private string connectedKey = "";

    private async Task LoadOfflineAsync()
    {
        var connected = Registry.Machines.Select(m => m.Id).ToHashSet();
        var key = string.Join('\n', connected.Order());
        if (key == connectedKey && offlineMachines.Count > 0) return;
        connectedKey = key;
        offlineMachines = (await Store.KnownMachinesAsync())
            .Where(k => !connected.Contains(k.Id) && Access.CanSee(user, k.Id))
            .OrderByDescending(k => k.LastSeen)
            .ToList();
    }

    private async Task ToggleOfflineAsync(string id)
    {
        if (openOffline.Remove(id)) return;
        var json = await Store.LastTreeAsync(id);
        openOffline[id] = json is null ? null : SessionTree.Parse(JsonNode.Parse(json));
    }

    private string filter = "";

    private PeriodicTimer? pullTimer;

    // Lazy pull (ADR 0001, D11): trees are fetched only while this page is open,
    // and a tree younger than 2 s is shared by everyone looking at it.
    protected override void OnInitialized()
    {
        // Both lifecycle methods run: this one subscribes, OnInitializedAsync
        // loads the user and then starts pulling.
        Registry.Changed += OnChanged;
    }

    private async Task PullLoopAsync(PeriodicTimer timer)
    {
        do
        {
            // Pull only machines this user can see.
            await Registry.RefreshTreesAsync(TimeSpan.FromSeconds(2), m => Access.CanSee(user, m.Id));
        } while (await timer.WaitForNextTickAsync());
    }

    private int renderQueued;

    // Many machines can change at once; repaint at most four times a second.
    private void OnChanged()
    {
        if (Interlocked.Exchange(ref renderQueued, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(250);
            Interlocked.Exchange(ref renderQueued, 0);
            await LoadOfflineAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Registry.Changed -= OnChanged;
        pullTimer?.Dispose();
        if (scrollTrack is not null) _ = DisposeTrackAsync(scrollTrack);
    }

    private static async Task DisposeTrackAsync(IJSObjectReference track)
    {
        try
        {
            await track.InvokeVoidAsync("dispose");
            await track.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Every word must appear in the pane's machine, session, title, agent, status, folder or address.</summary>
    private IEnumerable<PaneInfo> Visible(string machineName, SessionTree tree, IEnumerable<PaneInfo> panes)
    {
        var words = filter.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0) return panes;
        return panes.Where(p =>
        {
            var session = tree.WorkspaceLabel(p.WorkspaceId);
            var hay = $"{machineName} {session} {p.DisplayName} {p.Title} {p.Agent} {Label(p.AgentStatus)} {p.Cwd} {machineName}/{session}/{p.Title}";
            return words.All(w => hay.Contains(w, StringComparison.OrdinalIgnoreCase));
        });
    }

    private async Task OnFilterAsync(ChangeEventArgs e)
    {
        filter = e.Value?.ToString() ?? "";
        try { await JS.InvokeVoidAsync("klarkState.set", "home:filter", filter, "s"); } catch (JSException) { }
    }

    private IJSObjectReference? scrollTrack;

    // Coming back to the list puts the search text and the scroll position back.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string?>("klarkState.get", "home:filter", "s");
            var last = await JS.InvokeAsync<string?>("klarkState.get", "home:last", "s");
            if ((!string.IsNullOrEmpty(saved) && saved != filter) || last != lastHref)
            {
                filter = saved ?? "";
                lastHref = last;
                // Scroll is restored on the next render, once the filtered list is drawn:
                // restoring against the unfiltered list lands on the wrong row.
                StateHasChanged();
                return;
            }
        }
        if (scrollTrack is null && !trackStarting)
        {
            trackStarting = true;
            scrollTrack = await JS.InvokeAsync<IJSObjectReference>("klarkState.trackScroll", "home", ".home-list", "a.last");
        }
    }

    private bool trackStarting;

    /// <summary>The pane you last opened from here: marked, and scrolled to if there is no saved position.</summary>
    private string? lastHref;

    private static string Sub(SessionTree tree, PaneInfo p)
    {
        var parts = new List<string>();
        if (p.Agent.Length > 0 && !p.DisplayName.StartsWith(p.Agent + " ·")) parts.Add(p.Agent);
        if (p.Folder.Length > 0 && !p.DisplayName.EndsWith(p.Folder)) parts.Add(p.Folder);
        var session = tree.WorkspaceLabel(p.WorkspaceId);
        if (session.Length > 0 && session != p.Folder) parts.Add(session);
        return string.Join(" · ", parts);
    }

    // Blocked agents first: those are the ones waiting for a person.
    private static int Rank(string status) => status switch { "blocked" => 3, "working" => 2, "idle" => 1, _ => 0 };
    private static string Css(string status) => string.IsNullOrEmpty(status) ? "none" : status;
    private static string Label(string status) => string.IsNullOrEmpty(status) ? "shell" : status;
}
