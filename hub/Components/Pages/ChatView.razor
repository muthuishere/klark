@* The Transcript tab as a chat (ADR 0011, D). One shared ~1 Hz poll per pane
   (TranscriptFeeds) runs only while a ChatView is open; this component only
   re-renders when the feed's version moves, and each row only when it grows. *@
@implements IAsyncDisposable
@inject TranscriptFeeds Feeds
@inject IJSRuntime JS

@if (SearchOpen)
{
    <div class="chat-search">
        <input @ref="searchBox" autofocus placeholder="Search loaded messages" value="@query" @oninput="OnSearchAsync" @onkeydown="SearchKeyAsync" />
        <span class="muted">@(query.Length == 0 ? "" : hits == 0 ? "none" : $"{at}/{hits}")</span>
        <button type="button" class="icon" aria-label="Previous match" @onclick="() => StepAsync(-1)">↑</button>
        <button type="button" class="icon" aria-label="Next match" @onclick="() => StepAsync(1)">↓</button>
    </div>
}

<div class="chat-scroll" @ref="scroller">
    <div class="chat-col" data-lo="@lo" data-hi="@hi">
        @if (lo > 0)
        {
            @* Fallback for the automatic loading chat.js does while scrolling up. *@
            <button type="button" class="earlier" @onclick="ShowEarlier">Show @Math.Min(lo, Page) earlier</button>
        }
        @if (rows.Count == 0)
        {
            @if (feed.Error is { } e) { <p class="empty chat-empty">Transcript unavailable: @e</p> }
            else if (feed.Version == 0) { <ChatSkeleton /> }
            else { <p class="empty chat-empty">Nothing here yet.</p> }
        }
        @* Long chats draw only rows [lo, hi); chat.js sizes these two pads from measured heights. *@
        @if (lo > 0) { <div class="chat-pad" data-pad="top" aria-hidden="true"></div> }
        @for (var i = lo; i < hi && i < rows.Count; i++)
        {
            var row = rows[i];
            <ChatRow @key="row.Key" Row="row" MachineId="@MachineId" PaneId="@PaneId" />
        }
        @if (hi < rows.Count) { <div class="chat-pad" data-pad="bottom" aria-hidden="true"></div> }
        @if (Files is { Count: > 0 })
        {
            @* Files the agent offered (`klark offer`), as attachments. *@
            <div class="files">
                @foreach (var a in Files.OrderBy(a => a.Ts))
                {
                    <div class="fcard">
                        @if (a.IsImage)
                        {
                            <a class="fthumb" href="@a.Url" target="_blank" rel="noopener"><img src="@a.Url" alt="@a.Name" loading="lazy" /></a>
                        }
                        else
                        {
                            <span class="ficon">@((MarkupString)Icons.File)</span>
                        }
                        <span class="fmeta"><span class="fname">@a.Name</span><span class="muted">@FileLinks.Size(a.Size) · @a.Mime</span></span>
                        <a class="icon" href="@a.Url" download="@a.Name" title="Download" aria-label="Download @a.Name">@((MarkupString)Icons.Download)</a>
                    </div>
                }
            </div>
        }
        @if (feed.Blocked is { } b)
        {
            <div class="blocked">
                <div class="blocked-label">Waiting for you</div>
                @if (b.Question.Length > 0) { <pre class="blocked-q">@b.Question</pre> }
                <div class="quick">
                    @foreach (var o in b.Options)
                    {
                        <button type="button" class="@(chosen == b.Question + "\n" + o.Send ? "chosen" : null)" disabled="@ReadOnly" @onclick="() => ChooseAsync(b.Question, o.Send, o.Enter)">@o.Label</button>
                    }
                    <button type="button" class="ghost" disabled="@ReadOnly" @onclick='() => QuickReply.InvokeAsync(("\u001b", false))'>Esc</button>
                </div>
            </div>
        }
    </div>
</div>
<button type="button" class="jump" @ref="pill">Jump to latest ↓</button>
<div class="live live-@feed.Status">@if (feed.Status is "working" or "blocked") {<span class="dot"></span>@(feed.Status == "working" ? "Working…" : "Needs your answer")}</div>

@code {
    [Parameter, EditorRequired] public string MachineId { get; set; } = "";
    [Parameter, EditorRequired] public string PaneId { get; set; } = "";
    [Parameter] public bool Live { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool SearchOpen { get; set; }
    [Parameter] public EventCallback<(string Send, bool Enter)> QuickReply { get; set; }
    /// <summary>Files the agent offered for this pane, drawn as attachment cards.</summary>
    [Parameter] public IReadOnlyList<Asset>? Files { get; set; }
    /// <summary>A sidebar search hit: the item to scroll to once it is drawn.</summary>
    [Parameter] public string? Hit { get; set; }
    private bool hitShown;

    /// <summary>Rows the fallback button adds above the window.</summary>
    private const int Page = 150;

    private TranscriptFeed feed = default!;
    private IDisposable? lease;
    private List<ChatRowModel> rows = new();
    private long rowsVersion = -1;
    /// <summary>The rows in the DOM: [lo, hi). chat.js moves it as the reader scrolls (ChatWindow).</summary>
    private int lo, hi;
    private string sentRows = "";
    private DotNetObjectReference<ChatView>? self;
    private long renderedVersion = -1;
    private bool attached;
    private ElementReference scroller, pill, searchBox;
    private string query = "";
    private int hits, at;
    private string Key => MachineId + "/" + PaneId;

    protected override void OnInitialized()
    {
        // The cached feed paints at once; the poll then asks only for what is newer.
        feed = Feeds.Get(MachineId, PaneId);
        Rebuild();
        (lo, hi) = ChatWindow.Initial(rows.Count);
    }

    private void OnFeed()
    {
        if (feed.Version == renderedVersion) return;
        _ = InvokeAsync(() =>
        {
            Rebuild();
            StateHasChanged();
        });
    }

    private void Rebuild()
    {
        if (rowsVersion == feed.Version) return;
        rowsVersion = feed.Version;
        var old = rows.Count;
        rows = ChatRowModel.Build(feed.Items);
        (lo, hi) = ChatWindow.Follow(lo, hi, old, rows.Count);
    }

    protected override bool ShouldRender()
    {
        renderedVersion = feed.Version;
        return true;
    }

    private void ShowEarlier() => (lo, hi) = ChatWindow.Earlier(lo, hi, Page, rows.Count);

    /// <summary>chat.js asks for another window of rows as the reader scrolls.</summary>
    [JSInvokable]
    public Task SetWindow(int newLo, int newHi) => InvokeAsync(() =>
    {
        var w = ChatWindow.Clamp(newLo, newHi, rows.Count);
        if (w == (lo, hi)) return;
        (lo, hi) = w;
        StateHasChanged();
    });

    /// <summary>Keys and height guesses of all rows, for chat.js to lay the pads out; sent when the rows change.</summary>
    private async Task SendRowsAsync()
    {
        var sig = rows.Count + "/" + (rows.Count > 0 ? rows[0].Key + "/" + rows[^1].Key : "");
        if (sig == sentRows) return;
        sentRows = sig;
        await JS.InvokeVoidAsync("klarkChat.rows", Key, rows.Select(r => r.Key).ToArray(), rows.Select(ChatWindow.Estimate).ToArray());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!attached)
        {
            attached = true;
            // Polling starts only in a live circuit, never during prerendering.
            if (Live) lease = Feeds.Watch(MachineId, PaneId, OnFeed);
            self = DotNetObjectReference.Create(this);
            sentRows = "";
            await JS.InvokeVoidAsync("klarkChat.attach", Key, scroller, pill, self);
            await SendRowsAsync();
            chosen = await JS.InvokeAsync<string?>("klarkState.get", "qr:" + Key, "s");
            if (SearchOpen) await RestoreSearchAsync();
            else if (chosen is not null) StateHasChanged();
        }
        else await SendRowsAsync();
        if (Hit is { Length: > 0 } && !hitShown)
        {
            // The hit may sit outside the drawn rows: move the window to it first.
            var at = -1;
            for (var i = 0; i < rows.Count; i++) if (rows[i].Items.Any(x => x.Id == Hit)) at = i;
            if (at >= 0 && (at < lo || at >= hi))
            {
                (lo, hi) = ChatWindow.AroundRow(at, rows.Count);
                await JS.InvokeVoidAsync("klarkChat.pin", Key);
                StateHasChanged();
                return;
            }
            if (at >= 0) hitShown = await JS.InvokeAsync<bool>("klarkChat.reveal", Key, rows[at].Key);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!SearchOpen && searchWasOpen)
        {
            query = "";
            hits = at = 0;
            if (attached)
            {
                await JS.InvokeAsync<int>("klarkChat.search", Key, "");
                await JS.InvokeVoidAsync("klarkState.set", "searchq:" + Key, "", "s");
            }
        }
        else if (SearchOpen && !searchWasOpen && attached)
        {
            searchWasOpen = true;
            await RestoreSearchAsync();
        }
        searchWasOpen = SearchOpen;
    }

    private bool searchWasOpen;
    /// <summary>The quick reply last chosen for the question on screen, as "question\nkey".</summary>
    private string? chosen;

    private async Task ChooseAsync(string question, string send, bool enter)
    {
        chosen = question + "\n" + send;
        try { await JS.InvokeVoidAsync("klarkState.set", "qr:" + Key, chosen, "s"); } catch (JSException) { }
        await QuickReply.InvokeAsync((send, enter));
    }

    /// <summary>Search left open comes back with its text and the same match selected.</summary>
    private async Task RestoreSearchAsync()
    {
        searchWasOpen = true;
        var saved = await JS.InvokeAsync<string?>("klarkState.get", "searchq:" + Key, "s");
        if (string.IsNullOrEmpty(saved)) return;
        query = saved;
        hits = await JS.InvokeAsync<int>("klarkChat.search", Key, query, true);
        at = hits > 0 ? await JS.InvokeAsync<int>("klarkChat.current", Key) : 0;
        StateHasChanged();
    }

    private async Task OnSearchAsync(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        await JS.InvokeVoidAsync("klarkState.set", "searchq:" + Key, query, "s");
        hits = await JS.InvokeAsync<int>("klarkChat.search", Key, query);
        at = hits > 0 ? hits : 0;
    }

    private async Task StepAsync(int dir)
    {
        if (hits > 0) at = await JS.InvokeAsync<int>("klarkChat.step", Key, dir);
    }

    private Task SearchKeyAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" ? StepAsync(e.ShiftKey ? 1 : -1) : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        lease?.Dispose();
        self?.Dispose();
        if (!attached) return;
        try { await JS.InvokeVoidAsync("klarkChat.detach", Key); }
        catch (JSDisconnectedException) { }
    }
}
