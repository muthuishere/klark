@page "/m/{MachineId}/p/{PaneId}"
@attribute [Authorize]
@rendermode InteractiveServer

@* The app shell (ADR 0011, E): the sidebar stays mounted while you move between chats;
   the pane itself is keyed, so each chat starts with fresh state. *@
<div class="app">
    <Sidebar MachineId="@MachineId" PaneId="@PaneId" />
    <PaneMain @key="@(MachineId + "/" + PaneId)" MachineId="@MachineId" PaneId="@PaneId" ViewQuery="@ViewQuery" Hit="@Hit" />
</div>

@code {
    [Parameter] public string MachineId { get; set; } = "";
    [Parameter] public string PaneId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "hit")] public string? Hit { get; set; }
}
