@page "/m/{MachineId}/p/{PaneId}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Security.Claims
@using System.Text.Json.Nodes
@inject MachineRegistry Registry
@inject HubStore Store
@inject HubAccess Access
@inject AssetService AssetSvc
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Title · klark</PageTitle>

<div class="pane-app" @ref="root">
    <header class="pane-bar">
        @* Plain onclick: works before the circuit is up, and never leaves the app (klarkNav.back). *@
        <a class="icon back" href="/" onclick="return klarkNav.back(event)" aria-label="Back">‹</a>
        <div class="who" title="@StatusLabel">
            <span class="dot dot-@StatusCss"></span><span class="name">@Title</span>
            @if (view == "terminal") { <span class="tabtag">Terminal</span> }
        </div>
        @if (allowed)
        {
            <details class="menu" @ref="menu">
                <summary class="icon" aria-label="More">⋯</summary>
                <div class="menu-pop">
                    @if (view == "terminal")
                    {
                        <button type="button" class="menu-item" @onclick='() => SetView("chat")'>Chat</button>
                    }
                    else
                    {
                        <button type="button" class="menu-item" @onclick='() => SetView("terminal")'>Terminal</button>
                        <button type="button" class="menu-item" @onclick="ToggleSearchAsync">@(searchOpen ? "Close search" : "Search")</button>
                    }
                    <div class="menu-info">
                        <div>@(offline ? "offline" : StatusLabel)</div>
                        <div>@MachineId@(pane is not null && machine is not null ? " · " + machine.Tree.WorkspaceLabel(pane.WorkspaceId) : "")</div>
                        @if (!string.IsNullOrEmpty(pane?.Cwd)) { <div class="mono">@pane.Cwd</div> }
                    </div>
                </div>
            </details>
        }
    </header>

    @if (!allowed)
    {
        <p class="empty pad">Machine <b>@MachineId</b> is not available to you.</p>
    }
    else
    {
        <div class="pane-body">
            @if (view is null)
            {
                <div class="chat"><div class="chat-scroll"><div class="chat-col"><ChatSkeleton /></div></div></div>
            }
            @if (view == "chat")
            {
                <div class="chat">
                    <ChatView MachineId="@MachineId" PaneId="@PaneId" Live="@(!offline)" ReadOnly="@readOnly" SearchOpen="@searchOpen" QuickReply="QuickReplyAsync" />
                </div>
            }
            <div class="terminal-view" style="@(view == "terminal" ? "" : "display:none")">
                @if (closedReason is not null) { <div class="notice">Stream ended: @closedReason</div> }
                @if (offline) { <div class="notice">Machine offline: showing what was last recorded.</div> }
                <div class="term-wrap" @ref="terminalHost"></div>
            </div>
        </div>

        @if (offers.Count > 0)
        {
            <details class="offers" open="@offersOpen" @ontoggle="ToggleOffersAsync" @ref="offersEl">
                <summary title="Files expire after @RetentionLabel">Files · @offers.Count</summary>
                <div class="offer-list">
                    @foreach (var a in offers)
                    {
                        @if (a.IsImage)
                        {
                            <a class="offer img" href="@a.Url" target="_blank" rel="noopener"><img src="@a.Url" alt="@a.Name" loading="lazy" /></a>
                        }
                        else
                        {
                            <a class="offer file" href="@a.Url" download="@a.Name">@a.Name <span class="muted">@Size(a.Size)</span></a>
                        }
                    }
                </div>
            </details>
        }

        @if (uploadStatus is not null)
        {
            <div class="toast @(uploadOk ? "" : "bad")" @onclick="() => uploadStatus = null">@uploadStatus</div>
        }

        @if (!offline && !readOnly)
        {
            <div class="composer">
                <InputFile id="@("up-" + termId)" class="hidden-file" accept="image/*" OnChange="UploadAsync" @ref="fileInput" />
                <InputFile id="@("cam-" + termId)" class="hidden-file" accept="image/*" capture="environment" OnChange="UploadAsync" />
                <label for="@("up-" + termId)" class="icon attach" title="Attach an image (paste and drop work too; files expire after @RetentionLabel)">＋</label>
                <label for="@("cam-" + termId)" class="icon attach cam" title="Take a photo">◎</label>
                <textarea rows="1" placeholder="@(uploading ? "Sending image…" : "Message")" @bind="reply" @bind:event="oninput" @ref="textarea"></textarea>
                @if (view == "terminal")
                {
                    <button type="button" class="icon key" title="Esc" @onclick='() => KeysAsync("esc")'>esc</button>
                    <button type="button" class="icon key" title="Ctrl-C" @onclick='() => KeysAsync("ctrl+c")'>^C</button>
                }
                <button type="button" class="send" @onclick="SendAsync" @ref="sendButton" aria-label="Send">↑</button>
            </div>
        }
        else if (readOnly && !offline)
        {
            <div class="composer muted ro">Read-only</div>
        }
    }
</div>

@code {
    [Parameter] public string MachineId { get; set; } = "";
    [Parameter] public string PaneId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }

    private ClaimsPrincipal user = new();
    private bool allowed, readOnly, offline;
    private MachineConnection? machine;
    private PaneInfo? pane;
    private ElementReference root, terminalHost, textarea, sendButton, menu, offersEl;
    private InputFile? fileInput;
    private IAsyncDisposable? watch;
    private string reply = "";
    private string? closedReason;
    private string? view;
    private bool searchOpen, termOpened, offersOpen = true;
    private List<Asset> offers = new();
    private string? uploadStatus;
    private bool uploadOk, uploading;
    private readonly string termId = Guid.NewGuid().ToString("N");
    private string PaneKey => MachineId + "/" + PaneId;

    private string Title => pane?.DisplayName is { Length: > 0 } t ? t : PaneId;
    private string StatusCss => offline ? "none" : string.IsNullOrEmpty(pane?.AgentStatus) ? "none" : pane!.AgentStatus;
    private string StatusLabel => string.IsNullOrEmpty(pane?.AgentStatus) ? (pane?.Agent is { Length: > 0 } a ? a : "shell") : $"{pane!.Agent} {pane.AgentStatus}".Trim();
    private string RetentionLabel => AssetSvc.Options.RetentionHours is var h && h % 1 == 0 ? $"{h} h" : $"{h:0.#} h";

    protected override async Task OnInitializedAsync()
    {
        user = (await Auth.GetAuthenticationStateAsync()).User;
        allowed = Access.CanSee(user, MachineId);
        readOnly = !Access.CanType(user, MachineId);
        if (!allowed) return;

        Registry.Changed += OnChanged;
        AssetSvc.Offered += OnOffered;
        offers = AssetSvc.Offers(MachineId, PaneId);
        Refresh();
        if (machine is not null)
        {
            machine.PaneSizeChanged += OnPaneSize;
            _ = machine.EnsureTreeAsync(TimeSpan.FromSeconds(5)).ContinueWith(_ => OnChanged());
        }
        else if (await Store.LastTreeAsync(MachineId) is { } json)
        {
            // Offline: the last tree recorded in this machine's SQLite file (STATUS S-07).
            offline = true;
            pane = SessionTree.Parse(JsonNode.Parse(json)).Panes.FirstOrDefault(p => p.Id == PaneId);
        }
        else
        {
            offline = true;
        }
        if (ViewQuery is "chat" or "terminal") view = ViewQuery;
    }

    protected override void OnParametersSet()
    {
        // Browser back/forward between ?view=chat and ?view=terminal.
        if (ViewQuery is "chat" or "terminal" && view is not null && ViewQuery != view) view = ViewQuery;
    }

    private void Refresh()
    {
        machine = Registry.Get(MachineId);
        if (machine is not null) pane = machine.Tree.Panes.FirstOrDefault(p => p.Id == PaneId) ?? pane;
    }

    private void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void OnOffered(string m, string p)
    {
        if (m != MachineId || p != PaneId) return;
        _ = InvokeAsync(() => { offers = AssetSvc.Offers(MachineId, PaneId); offersOpen = true; StateHasChanged(); });
    }

    private void OnPaneSize(string paneId, int cols, int rows)
    {
        if (paneId != PaneId || !termOpened) return;
        _ = InvokeAsync(() => JS.InvokeVoidAsync("klarkTerm.resize", termId, cols, rows).AsTask());
    }

    private async Task ToggleSearchAsync()
    {
        searchOpen = !searchOpen;
        try
        {
            await JS.InvokeVoidAsync("klarkUi.closeMenu", menu);
            await JS.InvokeVoidAsync("klarkState.set", "searchopen:" + PaneKey, searchOpen ? "1" : "", "s");
        }
        catch (JSException) { }
    }

    private async Task ToggleOffersAsync()
    {
        // Read the element: a toggle event also fires when the open attribute is first rendered.
        try { offersOpen = await JS.InvokeAsync<bool>("klarkUi.isOpen", offersEl); } catch (JSException) { return; }
        try { await JS.InvokeVoidAsync("klarkState.set", "offers:" + PaneKey, offersOpen ? "" : "closed", "s"); } catch (JSException) { }
    }

    private string ViewUrl(string v) => Nav.GetUriWithQueryParameter("view", v);

    private async Task SetView(string v)
    {
        if (view == v) return;
        view = v;
        try
        {
            await JS.InvokeVoidAsync("klarkUi.closeMenu", menu);
            await JS.InvokeVoidAsync("klarkState.set", "view:" + PaneKey, v);
        }
        catch (JSException) { }
        Nav.NavigateTo(ViewUrl(v), replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!allowed) return;
        if (firstRender)
        {
            // Per tab: search left open, and files folded away, come back as they were.
            searchOpen = await JS.InvokeAsync<string?>("klarkState.get", "searchopen:" + PaneKey, "s") == "1";
            offersOpen = await JS.InvokeAsync<string?>("klarkState.get", "offers:" + PaneKey, "s") != "closed";
            if (searchOpen) StateHasChanged();
            if (view is null)
            {
                // Per pane, the last tab this browser used; else phones get Chat and desktops Terminal.
                var saved = await JS.InvokeAsync<string?>("klarkState.get", "view:" + PaneKey);
                view = saved is "chat" or "terminal" ? saved : await JS.InvokeAsync<bool>("klarkState.isNarrow") ? "chat" : "terminal";
                StateHasChanged();
            }
            if (!offline && !readOnly)
            {
                await JS.InvokeVoidAsync("klarkChat.composer", PaneKey, textarea, sendButton);
                await JS.InvokeVoidAsync("klarkChat.uploads", root, fileInput?.Element);
            }
        }
        if (view == "terminal" && !termOpened)
        {
            termOpened = true;
            await OpenTerminalAsync();
        }
        else if (view == "terminal")
        {
            await JS.InvokeVoidAsync("klarkTerm.rescale", termId);
        }
    }

    /// <summary>The terminal starts only when its tab is first shown (ADR 0002: nothing streams unwatched).</summary>
    private async Task OpenTerminalAsync()
    {
        // Pane's own size (ADR 0011, C); before a v3 machine reports one, klark's observe default.
        var size = machine?.PaneSize(PaneId) ?? (120, 40);
        await JS.InvokeVoidAsync("klarkTerm.open", termId, terminalHost, size.Cols, size.Rows);

        if (machine is null)
        {
            var recorded = await Store.RecentOutputAsync(MachineId, PaneId);
            if (recorded.Length > 0) await JS.InvokeVoidAsync("klarkTerm.writeBase64", termId, Convert.ToBase64String(recorded));
            else await JS.InvokeVoidAsync("klarkTerm.write", termId, "(nothing was recorded for this pane while it was watched)");
            return;
        }

        // Paint the current screen first, then follow the live stream.
        watch = machine.Watch(PaneId,
            bytes => InvokeAsync(() => JS.InvokeVoidAsync("klarkTerm.writeBase64", termId, bytes).AsTask()),
            reason => InvokeAsync(() => { closedReason = reason; StateHasChanged(); }),
            screen => InvokeAsync(() => JS.InvokeVoidAsync("klarkTerm.reset", termId, screen).AsTask()));
        try
        {
            var screen = await machine.ReadScreenAsync(PaneId);
            // Written raw (ADR 0011, C): no \n to \r\n rewriting.
            await JS.InvokeVoidAsync("klarkTerm.write", termId, screen);
            if (machine.PaneSize(PaneId) is { } s) await JS.InvokeVoidAsync("klarkTerm.resize", termId, s.Cols, s.Rows);
        }
        catch (Exception e) when (e is TimeoutException or InvalidOperationException)
        {
            closedReason = e.Message;
            StateHasChanged();
        }
    }

    private async Task SendAsync()
    {
        // Checked here, on the server, not just by hiding the form (STATUS S-06).
        var text = reply.TrimEnd();
        if (machine is null || text.Length == 0 || !Access.CanType(user, MachineId)) return;
        reply = "";
        await machine.SendInputAsync(PaneId, text);
        await machine.SendKeysAsync(PaneId, "enter");
    }

    private async Task QuickReplyAsync((string Send, bool Enter) r)
    {
        if (machine is null || !Access.CanType(user, MachineId)) return;
        if (r.Send == "\u001b") { await machine.SendKeysAsync(PaneId, "esc"); return; }
        await machine.SendInputAsync(PaneId, r.Send);
        if (r.Enter) await machine.SendKeysAsync(PaneId, "enter");
    }

    private Task KeysAsync(string key) =>
        machine is not null && Access.CanType(user, MachineId) ? machine.SendKeysAsync(PaneId, key) : Task.CompletedTask;

    /// <summary>Picked, pasted, dropped or photographed: store, then fetch_asset to the machine (ADR 0011, B).</summary>
    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (uploading) return;
        uploading = true;
        uploadStatus = $"Sending {e.File.Name}…";
        uploadOk = true;
        StateHasChanged();
        try
        {
            using var buffer = new MemoryStream();
            try
            {
                await using var s = e.File.OpenReadStream(AssetSvc.Options.MaxImageBytes);
                await s.CopyToAsync(buffer);
            }
            catch (IOException)
            {
                uploadStatus = $"{e.File.Name} is larger than {Size(AssetSvc.Options.MaxImageBytes)}";
                uploadOk = false;
                return;
            }
            buffer.Position = 0;
            var caption = reply.Trim();
            var r = await AssetSvc.SendToAgentAsync(user, MachineId, PaneId, buffer, e.File.Name, caption, CancellationToken.None);
            uploadOk = r.Status == 200;
            if (uploadOk) reply = "";
            uploadStatus = uploadOk ? $"Sent {r.Asset!.Name} → {r.Path}" : $"Not sent: {r.Error}";
        }
        finally
        {
            uploading = false;
        }
    }

    private static string Size(long b) => b >= 1 << 20 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0} KB" : $"{b} B";

    public async ValueTask DisposeAsync()
    {
        Registry.Changed -= OnChanged;
        AssetSvc.Offered -= OnOffered;
        if (machine is not null) machine.PaneSizeChanged -= OnPaneSize;
        if (watch is not null) await watch.DisposeAsync();
        try { if (termOpened) await JS.InvokeVoidAsync("klarkTerm.close", termId); }
        catch (JSDisconnectedException) { }
    }
}
