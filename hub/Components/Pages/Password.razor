@page "/account/password"
@attribute [Authorize]

<PageTitle>Password · @Brand.Title</PageTitle>

<section class="login">
    <h1>Change password</h1>
    <Notice Ok="@Ok" Error="@Error" />
    @if (Source is DirectoryUser.BuiltIn or DirectoryUser.Mock)
    {
        <form method="post" action="/account/password">
            <AntiforgeryToken />
            <label>Current password <input name="current" type="password" autocomplete="current-password" required /></label>
            <label>New password <input name="next" type="password" autocomplete="new-password" minlength="8" required /></label>
            <label>New password again <input name="confirm" type="password" autocomplete="new-password" minlength="8" required /></label>
            <button type="submit">Change password</button>
        </form>
    }
    else
    {
        <p class="muted">Your password is managed by your organisation's directory. Change it there.</p>
    }
</section>

@code {
    [SupplyParameterFromQuery] public string? Ok { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string? Source;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) Source = (await AuthState).User.FindFirst(AccountEndpoints.SourceClaim)?.Value;
    }
}
