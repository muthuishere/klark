{
  "name": "@muthuishere/klark-hub-ui",
  "version": "0.10.1",
  "description": "React components for watching and driving coding agents: chat view, composer, terminal, sidebar, over a pluggable Transport (klark hub's HTTP + SSE by default).",
  "license": "Apache-2.0",
  "author": "Muthukumaran Navaneethakrishnan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muthuishere/klark.git",
    "directory": "hub-go/ui/packages/hub-ui"
  },
  "homepage": "https://github.com/muthuishere/klark/tree/master/hub-go/ui/packages/hub-ui#readme",
  "bugs": "https://github.com/muthuishere/klark/issues",
  "keywords": [
    "react",
    "chat",
    "terminal",
    "xterm",
    "coding-agent",
    "klark"
  ],
  "type": "module",
